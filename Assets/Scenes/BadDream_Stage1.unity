--- !u!114 &630331618
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 630331616}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6fedf3c7e1fe14347b03652fead24d8e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteReader2D
  readRange: 2.6
  readKey: 19
  promptText: "E\uD0A4\uB97C \uB20C\uB7EC \uD3BC\uCE58\uAE30"
  sheet: {fileID: 21300000, guid: d33dfdb9935e060448e0ddac73fdc20c, type: 3}
  font: {fileID: 12800000, guid: 4e7331f9fd8a0604a816e16af86d666a, type: 3}
  fontSize: 22
  inkColor: {r: 0.13, g: 0.1, b: 0.09, a: 1}
  sheetHeight01: 0.92
  paperRect01:
    serializedVersion: 2
    x: 0.14
    y: 0.081
    width: 0.741
    height: 0.818
  writingInset01: 0.06
  openFadeDuration: 0.18
  noteBody: "\uB3C4\uC6C0\uB9D0\n\n\uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD \uBC84\uD2BC 
    -  \uBE5B\uC744 \uCF2D\uB2C8\uB2E4\n\uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC 
    -  \uAD11\uD0C4\uC744 \uC3E9\uB2C8\uB2E4\nShift  -  \uB300\uC2DC \uD68C\uD53C\n\n\uBAAC\uC2A4\uD130\uB97C
    \uBE5B\uC73C\uB85C \uBE44\uCD98 \uC0C1\uD0DC\uC5D0\uC11C \uAD11\uD0C4\uC744 \uB9DE\uD600\uC57C\n\uCC98\uCE58\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBE44\uCD94\uC9C0 \uC54A\uACE0 \uC3D8\uBA74
    \uB9DE\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\uC3D8\uB294 \uB3D9\uC548\uC5D0\uB3C4
    \uACC4\uC18D \uBE44\uCD94\uACE0 \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4.\n\n\uBE5B\uACFC
    \uB300\uC2DC\uB294 \uAC8C\uC774\uC9C0\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4.\n\uBE5B\uC740
    {lightSeconds}\uCD08\uAE4C\uC9C0 \uCF24 \uC218 \uC788\uACE0, \uB2E4 \uC4F0\uBA74\n{lockout}\uCD08
    \uB3D9\uC548 \uB2E4\uC2DC \uCF1C\uC9C0\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\uB300\uC2DC\uB294
    {dashCount}\uBC88\uAE4C\uC9C0 \uC5F0\uB2EC\uC544 \uC4F8 \uC218 \uC788\uACE0,\n\uD55C
    \uCE78\uC774 {dashRegen}\uCD08\uB9C8\uB2E4 \uB2E4\uC2DC \uCC39\uB2C8\uB2E4.\n\n\uC774
    \uACF5\uAC04\uC740 \uC800\uC911\uB825\uC774\uB77C \uCCB4\uAC10\uC774 \uB0AF\uC124
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
